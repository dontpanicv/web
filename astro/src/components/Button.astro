---
const {
  href,
  variant = 'primary',
  class: className = '',
} = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg';
const variants = {
  primary: 'bg-accent text-black hover:brightness-95 shadow-sm',
  secondary: 'bg-panel text-text border border-border hover:border-accent',
  ghost: 'text-text hover:bg-panel/60',
};

const classes = `${base} ${variants[variant] ?? variants.primary} ${className}`.trim();
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type="button" class={classes}>
    <slot />
  </button>
)}
