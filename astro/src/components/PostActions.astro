---
import { Icon } from 'astro-icon/components';

interface Props {
  /** Raw markdown body for the copy-for-LLM button */
  body: string;
  /** Post title (prepended to the copied markdown) */
  title: string;
  /** URL to X.com post announcing this article */
  xUrl?: string;
  /** URL to LinkedIn post announcing this article */
  linkedinUrl?: string;
  /** URL to Facebook post announcing this article */
  facebookUrl?: string;
}

const { body, title, xUrl, linkedinUrl, facebookUrl } = Astro.props;

const id = `md-${Math.random().toString(36).slice(2, 9)}`;
---

<span class="post-actions">
  <button
    type="button"
    class="post-action-btn llm-copy-btn"
    data-md-id={id}
    aria-label="Copy post as LLM friendly markdown"
    title="Copy post as LLM friendly markdown"
  >
    <Icon name="lucide:clipboard-copy" />
  </button>

  {xUrl && (
    <a href={xUrl} target="_blank" rel="noopener noreferrer" class="post-action-btn" aria-label="Discuss on X">
      <Icon name="simple-icons:x" />
    </a>
  )}

  {linkedinUrl && (
    <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="post-action-btn" aria-label="Discuss on LinkedIn">
      <Icon name="simple-icons:linkedin" />
    </a>
  )}

  {facebookUrl && (
    <a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="post-action-btn" aria-label="Discuss on Facebook">
      <Icon name="simple-icons:facebook" />
    </a>
  )}

  <template id={id}>
    <pre>{`# ${title}\n\n${body}`}</pre>
  </template>
</span>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.llm-copy-btn');
    if (!btn) return;

    const tpl = document.getElementById(btn.dataset.mdId!);
    if (!tpl) return;

    const md = (tpl as HTMLTemplateElement).content.textContent ?? '';

    try {
      await navigator.clipboard.writeText(md);
    } catch {
      // Fallback: select a temporary textarea
      const ta = document.createElement('textarea');
      ta.value = md;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }

    btn.classList.add('copied');
    setTimeout(() => btn.classList.remove('copied'), 1500);
  });
</script>

<style>
  .post-actions {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    vertical-align: middle;
  }

  .post-actions :global(svg) {
    width: 16px;
    height: 16px;
    display: block;
  }

  .post-action-btn {
    display: inline-flex;
    padding: 5px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .post-action-btn:hover {
    color: var(--ink);
    background: var(--accent);
  }

  .post-action-btn.copied {
    color: var(--ink);
    background: var(--accent);
    outline: 1px solid var(--ink);
  }
</style>
