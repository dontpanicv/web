---
import Container from './Container.astro';

const {
  lang = 'en',
  cvHref = lang === 'cs' ? '/cs/cv' : '/cv',
  langSwitchHref = lang === 'cs' ? '/' : '/cs/',
} = Astro.props;

const labels = {
  en: {
    home: 'Home',
    cv: 'CV',
  },
  cs: {
    home: 'Domů',
    cv: 'CV',
  },
};

const t = labels[lang] ?? labels.en;
const homeHref = lang === 'cs' ? '/cs/' : '/';
const otherLang = lang === 'cs' ? 'en' : 'cs';
const otherLangLabel = lang === 'cs' ? 'EN' : 'CZ';
---

<header class="border-b border-border bg-bg/80 backdrop-blur supports-[backdrop-filter]:bg-bg/60 sticky top-0 z-40">
  <Container class="py-4 flex items-center justify-between gap-4">
    <a href={homeHref} class="link flex items-center gap-3">
      <span class="font-semibold tracking-tight">Don’t Panic, V</span>
    </a>

    <nav class="flex items-center gap-3 text-sm">
      <a class="link text-muted hover:text-text" href={homeHref}>{t.home}</a>
      <span class="text-muted">·</span>
      <a class="link text-muted hover:text-text" href={cvHref}>{t.cv}</a>
      <span class="text-muted">·</span>
      <a
        class="link text-muted hover:text-text"
        href={langSwitchHref}
        data-lang-switch={otherLang}
        aria-label={`Switch language to ${otherLangLabel}`}
        title={`Switch language to ${otherLangLabel}`}
      >
        {otherLangLabel}
      </a>
    </nav>
  </Container>
</header>
