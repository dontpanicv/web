---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
---

<BaseLayout title="Contact · Don’t Panic, V" description="Contact">
  <Header slot="header" />

  <div class="space-y-8">
    <header class="space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
      <p class="text-muted">If you need me, I’m probably near a keyboard.</p>
    </header>

    <Card>
      <ul class="space-y-2">
        <li><span class="text-muted">Email:</span> <a href="mailto:kurka.vojtech@gmail.com">kurka.vojtech@gmail.com</a></li>
        <li><span class="text-muted">GitHub:</span> <a href="https://github.com/kurkavojtech" rel="me">github.com/kurkavojtech</a></li>
        <li><span class="text-muted">LinkedIn:</span> <span class="text-muted">(add link)</span></li>
      </ul>
    </Card>
  </div>

  <Footer slot="footer" />
</BaseLayout>
