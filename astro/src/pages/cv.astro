---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
---

<BaseLayout title="CV · Don’t Panic, V" description="Curriculum vitae">
  <Header slot="header" />

  <div class="space-y-10">
    <header class="space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight">CV</h1>
      <p class="text-muted">A concise timeline. The rest is just improbability.</p>
    </header>

    <section class="grid gap-4">
      <Card>
        <h2 class="font-semibold">Summary</h2>
        <p class="text-muted mt-2">Add a 2–3 sentence professional summary here.</p>
      </Card>
      <Card>
        <h2 class="font-semibold">Experience</h2>
        <ul class="mt-3 space-y-2 text-muted">
          <li><span class="text-text font-medium">Role</span> — Company (YYYY–YYYY)</li>
          <li><span class="text-text font-medium">Role</span> — Company (YYYY–YYYY)</li>
        </ul>
      </Card>
      <Card>
        <h2 class="font-semibold">Skills</h2>
        <p class="text-muted mt-2">Tech stack, tools, and what you’re good at.</p>
      </Card>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
