---
import TraceLayout from '../layouts/TraceLayout.astro';
---

<TraceLayout title="404 · Don't Panic, V!" description="Page not found">
  <main id="content">
    <article class="article">
      <h1>404</h1>
      <div class="shell"><div>$ cat this/page</div><div>cat: this/page: No such file or directory</div></div>
      <p class="think">This page has drifted into deep space. Don't panic.</p>
      <p class="more"><a href="/">← Back to the run</a></p>
    </article>
  </main>
</TraceLayout>
