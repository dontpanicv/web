---
import BrutalLayout from '../layouts/BrutalLayout.astro';
---

<BrutalLayout title="Dont's Panic, V!" description="Page not found" lang="en" langSwitchHref="/cs/">
  <div class="space-y-4 max-w-[70ch]">
    <h2 class="text-2xl font-semibold tracking-tight">404</h2>
    <p class="text-muted">This page has drifted into deep space.</p>
    <p>
      <a class="link" href="/">Back home</a>
    </p>
  </div>
</BrutalLayout>
