---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

const projects = [
  {
    title: 'Project name',
    desc: 'One-liner. What it does and why it matters.',
    stack: 'Astro · Tailwind · …',
    href: '#',
  },
  {
    title: 'Another project',
    desc: 'Keep it crisp. Link out to GitHub or demo.',
    stack: '…',
    href: '#',
  },
];
---

<BaseLayout title="Projects · Don’t Panic, V" description="Selected projects">
  <Header slot="header" />

  <div class="space-y-8">
    <header class="space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>
      <p class="text-muted">Things I’ve shipped. Some were intentional.</p>
    </header>

    <div class="grid md:grid-cols-2 gap-4">
      {projects.map((p) =>
        <Card>
          <h2 class="font-semibold">{p.title}</h2>
          <p class="text-muted mt-2">{p.desc}</p>
          <p class="text-muted mt-3 text-sm font-mono">{p.stack}</p>
          <div class="mt-4">
            <a class="text-sm" href={p.href}>Link →</a>
          </div>
        </Card>
      )}
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
