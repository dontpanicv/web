---
import BrutalLayout from '../../layouts/BrutalLayout.astro';
import PostActions from '../../components/PostActions.astro';

import { getCollection } from 'astro:content';
import * as fs from 'fs';
import * as path from 'path';

import { formatDate, postHref } from '../../lib/i18n';

const lang = 'en';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const filteredPosts = posts.filter((p) => p.data.status !== 'draft');
  
  // Process each post to read raw markdown
  const paths = [];
  for (const post of filteredPosts) {
    try {
      const contentDir = path.join(process.cwd(), 'src', 'content');
      const filePath = path.join(contentDir, post.collection, `${post.slug}.md`);
      const raw = fs.readFileSync(filePath, 'utf-8');
      paths.push({ params: { slug: post.slug }, props: { post, rawMarkdown: raw } });
    } catch {
      paths.push({ params: { slug: post.slug }, props: { post, rawMarkdown: null } });
    }
  }
  
  return paths;
}

const { post, rawMarkdown } = Astro.props;
const { Content } = await post.render();

// Use raw markdown if available, otherwise fall back to post.body
const bodyContent = rawMarkdown ?? post.body;

const csPosts = await getCollection('postsCs');
const key = post.data.translationKey ?? post.slug;
const csPost = csPosts.find((p) => (p.data.translationKey ?? p.slug) === key && p.data.status !== 'draft');
const langSwitchHref = csPost ? postHref('cs', csPost.slug) : '/cs/';
---

<BrutalLayout
  title={`${post.data.title} · Dont's Panic, V!`}
  description={post.data.summary ?? 'Post'}
  lang={lang}
  langSwitchHref={langSwitchHref}
>
  <article class="mx-auto max-w-[68ch] space-y-10">
    <header class="space-y-4">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight leading-[1.15] text-balance">{post.data.title}</h2>
      <div class="flex items-center gap-3 text-sm text-muted">
        <PostActions
          body={bodyContent}
          title={post.data.title}
          xUrl={post.data.xUrl}
          linkedinUrl={post.data.linkedinUrl}
          facebookUrl={post.data.facebookUrl}
        />
        <span>{formatDate(post.data.date, lang)}</span>
      </div>
    </header>

    <div class="content">
      <Content />
    </div>
  </article>
</BrutalLayout>
