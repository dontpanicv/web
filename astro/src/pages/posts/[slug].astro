---
import TraceLayout from '../../layouts/TraceLayout.astro';
import PostActions from '../../components/PostActions.astro';

import { getCollection } from 'astro:content';
import * as fs from 'fs';
import * as path from 'path';

import { formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const filteredPosts = posts.filter((p) => p.data.status !== 'draft');
  
  // Process each post to read raw markdown
  const paths = [];
  for (const post of filteredPosts) {
    try {
      const contentDir = path.join(process.cwd(), 'src', 'content');
      const filePath = path.join(contentDir, post.collection, `${post.slug}.md`);
      const raw = fs.readFileSync(filePath, 'utf-8');
      paths.push({ params: { slug: post.slug }, props: { post, rawMarkdown: raw } });
    } catch {
      paths.push({ params: { slug: post.slug }, props: { post, rawMarkdown: null } });
    }
  }
  
  return paths;
}

const { post, rawMarkdown } = Astro.props;
const { Content } = await post.render();

// Use raw markdown if available, otherwise fall back to post.body
const bodyContent = rawMarkdown ?? post.body;
---

<TraceLayout title={`${post.data.title} · Don't Panic, V!`} description={post.data.summary}>
  <main id="content">
    <article class="article">
      <h1>{post.data.title}</h1>
      <p class="by">
        {formatDate(post.data.date)} · V. Kurka
        <PostActions
          body={bodyContent}
          title={post.data.title}
          xUrl={post.data.xUrl}
          linkedinUrl={post.data.linkedinUrl}
          facebookUrl={post.data.facebookUrl}
        />
      </p>
      <div class="md">
        <Content />
      </div>
      <p class="more"><a href="/#writing">← All writing</a> · <a href="/#ask">Ask the agent about this</a></p>
    </article>
  </main>
</TraceLayout>
