---
// The homepage. The headline is a prompt box for a language model on the visitor's own device (src/agent/); the
// answer to the question it shows by default is written out under it, so the page says whose it is before anything
// is asked. Then come the files the agent reads: about, projects, writing, CV.
import Answer from '../components/home/Answer.astro';
import Ask from '../components/home/Ask.astro';
import Content from '../components/home/Content.astro';
import Instruments from '../components/home/Instruments.astro';
import { person } from '../data/profile';
import TraceLayout from '../layouts/TraceLayout.astro';
---

<TraceLayout layout="layout home" home>
  <div class="top">
    <h1 class="whose">{person.name}<span>{person.role} · {person.place}</span></h1>
    <!-- One numbered run: the conversation so far, then the prompt box as its next step. Before anything is
         asked the conversation is empty, so the prompt box is step 01 and reads as the headline. -->
    <div class="trace convo">
      <div id="followups" aria-live="polite"></div>
      <div class="headline"><Ask /></div>
      <div class="modelbar" id="modelbar" hidden></div>
    </div>
  </div>
  <aside class="rail" aria-label="The agent on this page">
    <Instruments />
  </aside>
  <main id="content" class="rest">
    <Answer />
    <Content />
  </main>
</TraceLayout>
