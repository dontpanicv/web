---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

const posts = [
  { title: 'First log entry', date: 'YYYY-MM-DD', desc: 'A short teaser for the post.', href: '#' },
  { title: 'Second log entry', date: 'YYYY-MM-DD', desc: 'Another teaser.', href: '#' },
];
---

<BaseLayout title="Blog · Don’t Panic, V" description="Blog posts">
  <Header slot="header" />

  <div class="space-y-8">
    <header class="space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
      <p class="text-muted">Notes, experiments, and occasional guidance.</p>
    </header>

    <div class="grid gap-4">
      {posts.map((p) =>
        <Card>
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-semibold">{p.title}</h2>
            <span class="text-sm text-muted font-mono">{p.date}</span>
          </div>
          <p class="text-muted mt-2">{p.desc}</p>
          <div class="mt-4">
            <a class="text-sm" href={p.href}>Read →</a>
          </div>
        </Card>
      )}
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
