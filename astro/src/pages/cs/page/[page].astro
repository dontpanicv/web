---
import BrutalLayout from '../../../layouts/BrutalLayout.astro';
import PostActions from '../../../components/PostActions.astro';

import { formatDate, postHref } from '../../../lib/i18n';
import { getPublishedPosts } from '../../../lib/posts';

const lang = 'cs';

export async function getStaticPaths({ paginate }) {
  const posts = await getPublishedPosts('cs');
  const paths = paginate(posts, { pageSize: 10 });
  // Page 1 is rendered at `/cs/` (index.astro); keep `/cs/page/2+` only.
  return paths.filter((p) => p.params.page !== '1');
}

const { page } = Astro.props;
const prevHref = page.currentPage === 2 ? '/cs/' : page.url.prev;
const nextHref = page.url.next;
const langSwitchHref = `/page/${page.currentPage}`;
---

<BrutalLayout
  title="Dont's Panic, V!"
  description="Příspěvky"
  lang={lang}
  langSwitchHref={langSwitchHref}
>
  <div class="space-y-6">
    <ul class="divide-y divide-border">
      {page.data.map((post) => (
        <li class="py-6 first:pt-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <a class="link text-lg font-medium text-text" href={postHref(lang, post.slug)}>
              {post.data.title}
            </a>
            <span class="inline-flex items-center gap-3 text-sm text-muted">
              <PostActions
                body={post.body}
                title={post.data.title}
                xUrl={post.data.xUrl}
                linkedinUrl={post.data.linkedinUrl}
                facebookUrl={post.data.facebookUrl}
              />
              <span>{formatDate(post.data.date, lang)}</span>
            </span>
          </div>
          {post.data.summary ? <p class="text-muted mt-2 leading-relaxed">{post.data.summary}</p> : null}
        </li>
      ))}
    </ul>

    <nav class="flex items-center justify-between pt-2">
      {prevHref ? (
        <a class="link text-sm" href={prevHref}>
          ← Novější
        </a>
      ) : (
        <span />
      )}
      {nextHref ? (
        <a class="link text-sm" href={nextHref}>
          Starší →
        </a>
      ) : (
        <span />
      )}
    </nav>
  </div>
</BrutalLayout>
