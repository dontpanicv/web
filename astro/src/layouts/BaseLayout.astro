---
import "../styles/global.css";

const {
  title = "Dont's Panic, V!",
  description = "Personal site · CV · posts",
  lang = "en",
  mainClass = "mx-auto max-w-5xl px-4 py-10",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/brand/logo.svg" />
    <link rel="icon" href="/brand/logo.svg" />

    <title>{title}</title>

    <!-- Minimal client JS: persist language choice (cookie) -->
    <script src="/lang.js" defer></script>
  </head>
  <body>
    <a class="link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-panel focus:px-4 focus:py-2" href="#content">
      Skip to content
    </a>

    <div class="min-h-dvh">
      <slot name="header" />

      <main id="content" class={mainClass}>
        <slot />
      </main>

      <slot name="footer" />
    </div>
  </body>
</html>
