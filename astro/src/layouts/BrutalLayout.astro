---
import BaseLayout from './BaseLayout.astro';

import { cvHref, homeHref } from '../lib/i18n';

const {
  lang = 'en',
  title = 'Dont\'s Panic, V!',
  description = 'Personal site · CV · posts',
  langSwitchHref,
} = Astro.props;

const otherLang = lang === 'en' ? 'cs' : 'en';
const otherLangLabel = otherLang === 'cs' ? 'CZ' : 'EN';
const aboutLabel = lang === 'cs' ? 'O mně' : 'About me';

const about =
  lang === 'cs'
    ? 'Spoluzakladatel a Head of R&D v Meiro (Customer Data Platform). Předtím: Solutions Architect a Head Nerd v Keboola. Stavím datové produkty a systémy kolem nich.'
    : 'Co-founder and Head of R&D at Meiro (Customer Data Platform). Previously: Solutions Architect and Head Nerd at Keboola. I build data-heavy products and the systems around them.';

const bio =
  lang === 'cs'
    ? 'Rád vím, jak věci fungují — od CPU a protokolů po databáze a kontejnery. Skoro deset let budování datové platformy v produkci mě naučilo většinu z toho. Teď tu zvědavost věnuji AI: lokální modely, agentní workflow a dostat to všechno do produkce pro reálné zákazníky. Když to neumím někomu vysvětlit, tak tomu ještě nerozumím.'
    : 'I like knowing how things work — from CPUs and protocols to databases and containers. Almost ten years of building a data platform in production taught me most of it. Now I spend that curiosity on AI: local models, agentic workflows, and getting it all into production for real customers. If I can\'t explain it to someone else, I don\'t understand it yet.';
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  mainClass="mx-auto w-full max-w-none px-6 sm:px-8 py-0"
>
  <div class="min-h-dvh py-10 md:py-0 grid gap-x-10 gap-y-12 md:grid-cols-[3fr_1fr] md:grid-rows-[25dvh_auto]">
    <header class="md:col-start-1 md:row-start-1 h-full flex items-center">
      <a class="text-text no-underline hover:opacity-90" href={homeHref(lang)} aria-label="Home">
        <h1 class="font-display font-bold tracking-tight leading-[0.82] text-[clamp(3.75rem,8vw,13rem)]">
          DONT PANIC, V!
        </h1>
      </a>
    </header>

    <div class="md:col-start-2 md:row-start-1 h-full w-full p-4 md:p-6 flex justify-end md:block">
      <img
        src="/brand/logo.svg"
        alt="Logo"
        width="696"
        height="666"
        class="h-auto w-[min(70vw,16rem)] md:h-full md:w-full object-contain"
        loading="eager"
      />
    </div>

    <aside class="md:col-start-2 md:row-start-2 space-y-6 md:pt-2">
      <ul class="space-y-1.5 text-sm">
        <li>
          <a class="link" href={cvHref(lang)}>{aboutLabel}</a>
          {langSwitchHref ? (
            <>
              {' '}
              <span class="text-muted" aria-hidden="true">|</span>{' '}
              <a
                class="link"
                href={langSwitchHref}
                data-lang-switch={otherLang}
                aria-label={`Switch language to ${otherLangLabel}`}
                title={`Switch language to ${otherLangLabel}`}
              >
                {otherLangLabel}
              </a>
            </>
          ) : null}
        </li>
        <li>
          <a class="link" href="mailto:kurka.vojtech@gmail.com">kurka.vojtech@gmail.com</a>
        </li>
        <li>
          <a class="link" href="https://www.linkedin.com/in/kurkavojtech/" rel="me">linkedin.com/in/kurkavojtech</a>
        </li>
      </ul>

      <p class="text-sm text-muted leading-relaxed">
        {bio}
      </p>

      <p class="text-sm text-muted leading-relaxed">
        {about}
      </p>
    </aside>

    <section class="md:col-start-1 md:row-start-2 md:pt-2 pb-12">
      <slot />
    </section>
  </div>
</BaseLayout>
